<% provide(:title, @user.name) %>
<div class="row">
  <aside class="col-md-4">
    <section class="user_info">
      <h1>
        <%= gravatar_for @user %>
        <%= @user.name %>
      </h1>
      <%= simple_format(@user.description) if @user.description.present? %>
    </section>
    <section class="stats">
      <%= render 'shared/stats' %>
    </section>
    <section class="web_site">
      <%= render 'shared/web_site' %>
    </section>
  </aside>
  <div class="col-md-8">

  <!-- 検索フォーム -->
  <%= form_with url: user_path(@user), method: :get, local: true do |f| %>
    <div class="search-form">
      <%= f.label :search, "キーワード検索" %>
      <div class="search-form-inner">
        <%= f.text_field :search,
          class: 'form-control',
          placeholder: 'キーワードを入力してください' %>
        <%= f.submit "検索", class: 'btn btn-primary' %>
      </div>
    </div>
  <% end %>

    <%= render 'follow_form' if logged_in? %>
    <% if @microposts.any? %>
      <h3>ポスト (<%= @user.microposts.count %>)</h3>
      <ol class="microposts">
        <%= render @microposts %>
      </ol>
      <%= will_paginate @microposts %>
    <% else params[:search].present? %>
      <p>「<%= params[:search] %>」に一致するポストがありません。</p>
    <% end %>
  </div>
</div>
